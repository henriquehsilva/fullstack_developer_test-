<div id="dashboard_metrics" class="grid gap-4 sm:grid-cols-3">
  <% total = User.count %>
  <% counts = User.group(:role).count %>
  <article class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
    <p class="text-sm font-medium text-slate-500">Total users</p>
    <p class="mt-2 text-4xl font-bold text-slate-900"><%= total %></p>
  </article>
  <article class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
    <p class="text-sm font-medium text-slate-500">Administrators</p>
    <p class="mt-2 text-4xl font-bold text-indigo-700"><%= counts.fetch("admin", 0) %></p>
  </article>
  <article class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
    <p class="text-sm font-medium text-slate-500">Standard users</p>
    <p class="mt-2 text-4xl font-bold text-emerald-700"><%= counts.fetch("user", 0) %></p>
  </article>
</div>
