<%= turbo_stream_from "admin_dashboard" %>

<section>
  <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <p class="text-sm font-semibold uppercase tracking-wider text-indigo-600">Administration</p>
      <h1 class="mt-1 text-3xl font-bold tracking-tight sm:text-4xl">User dashboard</h1>
      <p class="mt-2 text-slate-500">Live account totals update as users are created, changed, or deleted.</p>
    </div>
    <div class="flex gap-3">
      <%= link_to "Import users", new_admin_user_import_path, class: "rounded-lg border border-slate-300 bg-white px-4 py-2 font-semibold hover:bg-slate-50" %>
      <%= link_to "Add user", new_admin_user_path, class: "rounded-lg bg-indigo-600 px-4 py-2 font-semibold text-white hover:bg-indigo-500" %>
    </div>
  </div>

  <div class="mt-8"><%= render "metrics" %></div>
</section>
