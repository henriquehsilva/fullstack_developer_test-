<section class="mx-auto max-w-2xl rounded-2xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8"><h1 class="text-3xl font-bold">Import users</h1><p class="mt-2 text-slate-500">Upload a CSV or XLSX file up to 10 MB. Required columns are <code>full_name</code> and <code>email</code>; optional columns are <code>role</code> and <code>avatar_url</code>.</p><%= form_with model: [ :admin, @user_import ], class: "mt-6 space-y-5" do |form| %><%= render "shared/errors", record: @user_import %><%= form.file_field :spreadsheet, required: true, accept: ".csv,.xlsx,text/csv,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", class: "block w-full rounded-lg border border-slate-300 bg-white px-3 py-3" %><%= form.submit "Queue import", class: "cursor-pointer rounded-lg bg-indigo-600 px-4 py-3 font-semibold text-white" %><% end %></section>
