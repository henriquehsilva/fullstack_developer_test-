<article id="<%= dom_id(user_import) %>" class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
  <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between"><div><p class="font-semibold"><%= user_import.spreadsheet.filename if user_import.spreadsheet.attached? %></p><p class="text-sm text-slate-500">Submitted by <%= user_import.creator.full_name %> · <%= l(user_import.created_at, format: :short) %></p></div><span class="w-fit rounded-full px-3 py-1 text-xs font-semibold uppercase tracking-wide <%= user_import.failed? ? 'bg-red-100 text-red-700' : user_import.completed? ? 'bg-emerald-100 text-emerald-700' : 'bg-amber-100 text-amber-700' %>"><%= user_import.status %></span></div>
  <div class="mt-5 h-3 overflow-hidden rounded-full bg-slate-100" role="progressbar" aria-valuenow="<%= user_import.progress_percentage %>" aria-valuemin="0" aria-valuemax="100" aria-label="Import progress"><div class="h-full rounded-full bg-indigo-600 transition-all duration-500" style="width: <%= user_import.progress_percentage %>%"></div></div>
  <div class="mt-2 flex justify-between text-sm text-slate-500"><span><%= user_import.processed_rows %> of <%= user_import.total_rows %> rows</span><span><%= user_import.failed_rows %> failed</span></div>
  <% if user_import.error_details.any? %><details class="mt-4 rounded-lg bg-red-50 p-3 text-sm text-red-700"><summary class="cursor-pointer font-semibold">View errors</summary><ul class="mt-2 list-disc pl-5"><% user_import.error_details.first(20).each do |detail| %><li>Row <%= detail["row"] || "—" %>: <%= Array(detail["errors"] || detail["error"]).join(", ") %></li><% end %></ul></details><% end %>
</article>
