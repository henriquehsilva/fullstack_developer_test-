<section class="mx-auto max-w-3xl rounded-2xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8">
  <div class="flex flex-col gap-5 sm:flex-row sm:items-center sm:justify-between">
    <div class="flex items-center gap-4"><%= avatar_for(@user, classes: "size-20") %><div><h1 class="text-3xl font-bold"><%= @user.full_name %></h1><p class="text-slate-500"><%= @user.email %></p></div></div>
    <%= link_to "Edit user", edit_admin_user_path(@user), class: "rounded-lg bg-indigo-600 px-4 py-2 text-center font-semibold text-white hover:bg-indigo-500" %>
  </div>
  <dl class="mt-8 grid gap-4 border-t border-slate-200 pt-6 sm:grid-cols-2"><div><dt class="text-sm text-slate-500">Role</dt><dd class="font-semibold"><%= @user.role.titleize %></dd></div><div><dt class="text-sm text-slate-500">Created</dt><dd class="font-semibold"><%= l(@user.created_at, format: :long) %></dd></div></dl>
  <%= link_to "Back to users", admin_users_path, class: "mt-8 inline-block text-sm font-semibold text-indigo-700 hover:underline" %>
</section>
