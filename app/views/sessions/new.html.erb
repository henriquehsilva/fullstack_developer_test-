<div class="mx-auto max-w-md rounded-2xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8">
  <h1 class="text-3xl font-bold tracking-tight">Welcome back</h1>
  <p class="mt-2 text-sm text-slate-500">Sign in to manage your account.</p>

  <%= form_with url: session_url, class: "contents" do |form| %>
    <div class="my-5">
      <%= form.label :email, class: "text-sm font-medium" %>
      <%= form.email_field :email, required: true, autofocus: true, autocomplete: "username", placeholder: "you@example.com", value: params[:email], class: "mt-2 block w-full rounded-lg border border-slate-300 px-3 py-2 focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200" %>
    </div>

    <div class="my-5">
      <%= form.label :password, class: "text-sm font-medium" %>
      <%= form.password_field :password, required: true, autocomplete: "current-password", placeholder: "Your password", maxlength: 72, class: "mt-2 block w-full rounded-lg border border-slate-300 px-3 py-2 focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200" %>
    </div>

    <div class="col-span-6 sm:flex sm:items-center sm:gap-4">
      <div class="inline">
        <%= form.submit "Sign in", class: "w-full sm:w-auto text-center rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white inline-block font-medium cursor-pointer" %>
      </div>

      <div class="mt-4 text-sm text-gray-500 sm:mt-0">
        <%= link_to "Forgot password?", new_password_path, class: "text-indigo-700 hover:underline" %>
      </div>
    </div>
  <% end %>
  <p class="mt-6 text-center text-sm text-slate-500">New here? <%= link_to "Create an account", new_registration_path, class: "font-semibold text-indigo-700 hover:underline" %></p>
</div>
